#!groovy

def scheduledNightlyTriggers = env.BRANCH_NAME == 'master' ? [cron('H 17 * * *')] : []

properties([
  [
  $class       : 'GithubProjectProperty',
  displayName  : 'MediaViewer',
  projectUrlStr: 'https://github.com/hmcts/rpx-xui-media-viewer/'
  ],
  pipelineTriggers(scheduledNightlyTriggers),
  parameters([
    text(name: 'INTEGRATION_PW_PROFILE_RUNS', defaultValue: '''workers=7''', description: 'Integration load-profile matrix. One run per line or semicolon.'),
    string(name: 'INTEGRATION_PW_WORKERS', defaultValue: '', description: 'Optional integration worker-count override.'),
    string(name: 'INTEGRATION_PW_SHARD', defaultValue: '', description: 'Manual diagnostic-only integration shard override, for example 1/2.'),
    booleanParam(name: 'PLAYWRIGHT_IGNORE_GLOBAL_EXCLUDES', defaultValue: false, description: 'Bypass Key Vault-backed Playwright global exclusions for a verification run.'),
    booleanParam(name: 'RUN_PLAYWRIGHT_ACCESSIBILITY', defaultValue: true, description: 'Run the non-blocking unified Playwright accessibility pack.'),
    string(name: 'ENVIRONMENT', defaultValue: 'aat', description: 'Environment to test'),
    string(name: 'IDAM_API_URL', defaultValue: 'https://idam-api.aat.platform.hmcts.net', description: 'The Url of IDAM'),
    string(name: 'S2S_PROVIDER_URL', defaultValue: 'http://rpe-service-auth-provider-aat.service.core-compute-aat.internal', description: 'The Url of S2S provider'),
    string(name: 'CCD_DATA_STORE_URL', defaultValue: 'http://ccd-data-store-api-aat.service.core-compute-aat.internal', description: 'The Url of ccd data store'),
    string(name: 'SecurityRules',
      defaultValue: 'https://raw.githubusercontent.com/hmcts/security-test-rules/master/conf/security-rules.conf',
      description: 'The URL you want to run these tests against'),
  ])
])

@Library("Infrastructure@2.5.1")

def type = "nodejs"
def product = "xui"
def component = "media-viewer"
def channel   = '#xui-pipeline'

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)
def playwrightSmokeOutputRoot = 'functional-output/tests/playwright-smoke'
def playwrightSmokeOdhinReportFile = 'xui-playwright-smoke.html'
def playwrightSupportOutputRoot = 'functional-output/tests/playwright-support'
def playwrightFunctionalOutputRoot = 'functional-output/tests/playwright-functional'
def playwrightAccessibilityOutputRoot = 'functional-output/tests/playwright-accessibility'
def playwrightCrossbrowserOutputRoot = 'functional-output/tests/playwright-crossbrowser'
def playwrightSupportOdhinReportFile = 'xui-playwright-support.html'
def playwrightFunctionalOdhinReportFile = 'xui-playwright-functional.html'
def playwrightAccessibilityOdhinReportFile = 'xui-playwright-accessibility.html'
def playwrightCrossbrowserOdhinReportFile = 'xui-playwright-crossbrowser.html'
def playwrightSmokeOdhinTitle = 'RPX XUI Media Viewer Playwright Smoke'
def playwrightSupportOdhinTitle = 'RPX XUI Media Viewer Playwright Support'
def playwrightFunctionalOdhinTitle = 'RPX XUI Media Viewer Playwright Functional'
def playwrightAccessibilityOdhinTitle = 'RPX XUI Media Viewer Accessibility'
def playwrightCrossbrowserOdhinTitle = 'RPX XUI Media Viewer Playwright Cross-browser Smoke'

def playwrightBrowsersEnv = {
  ["PLAYWRIGHT_BROWSERS_PATH=${env.WORKSPACE}/.cache/ms-playwright"]
}

def publishPlaywrightJUnit = { String testResults, boolean skipMarkingBuildUnstable = false ->
  def junitArguments = [allowEmptyResults: false, testResults: testResults]
  if (skipMarkingBuildUnstable == true) {
    junitArguments.skipMarkingBuildUnstable = true
  }
  steps.junit(junitArguments)
}

def hasPlaywrightJUnit = { String outputRoot ->
  steps.sh(
    returnStatus: true,
    script: "find '${outputRoot}' -type f -name '*junit.xml' -print -quit | grep -q ."
  ) == 0
}

def publishPlaywrightReport = { String outputRoot, String reportName, String reportFile, boolean requireJUnit = true, boolean skipMarkingBuildUnstable = false ->
  steps.sh(
    "node scripts/ensure-odhin-report.js --report-dir '${outputRoot}/odhin-report' --report-file '${reportFile}' --suite-name '${reportName}'"
  )
  publishHTML([
    allowMissing         : true,
    alwaysLinkToLastBuild: true,
    keepAll              : true,
    reportDir            : "${outputRoot}/odhin-report",
    reportFiles          : reportFile,
    reportName           : reportName
  ])
  steps.archiveArtifacts(
    allowEmptyArchive: true,
    artifacts: "${outputRoot}/**"
  )
  if (hasPlaywrightJUnit(outputRoot)) {
    publishPlaywrightJUnit("${outputRoot}/**/*junit.xml", skipMarkingBuildUnstable)
  } else if (requireJUnit) {
    steps.error("No Playwright JUnit XML found for ${reportName} under ${outputRoot}")
  } else {
    echo "No Playwright JUnit XML found for ${reportName}; Odhín report publication was still completed."
  }
}

def runPlaywrightFunctionalTests = { String outputRoot, String reportName ->
  steps.sh("rm -rf -- '${outputRoot}'")
  withEnv(playwrightBrowsersEnv() + [
    "PLAYWRIGHT_TEST_OUTPUT_DIR=${outputRoot}/test-results",
    "PLAYWRIGHT_JUNIT_OUTPUT=${outputRoot}/playwright-functional-junit.xml",
    "PLAYWRIGHT_REPORT_FOLDER=${outputRoot}/odhin-report",
    "PLAYWRIGHT_REPORT_INDEX_FILENAME=${playwrightFunctionalOdhinReportFile}",
    "PLAYWRIGHT_REPORT_TITLE=${playwrightFunctionalOdhinTitle}",
    "TEST_TYPE=${params.ENVIRONMENT}",
    "PLAYWRIGHT_BASE_URL=http://localhost:3000/",
    "PLAYWRIGHT_SKIP_INSTALL=true"
  ]) {
    try {
      yarnBuilder.yarn('test:playwright:functional')
    } finally {
      publishPlaywrightReport(outputRoot, reportName, playwrightFunctionalOdhinReportFile)
    }
  }
}

def runPlaywrightAccessibilityTests = { String outputRoot, String reportName ->
  steps.sh("rm -rf -- '${outputRoot}'")
  withEnv(playwrightBrowsersEnv() + [
    "PLAYWRIGHT_TEST_OUTPUT_DIR=${outputRoot}/test-results",
    "PLAYWRIGHT_JUNIT_OUTPUT=${outputRoot}/playwright-accessibility-junit.xml",
    "PLAYWRIGHT_REPORT_FOLDER=${outputRoot}/odhin-report",
    "PLAYWRIGHT_REPORT_INDEX_FILENAME=${playwrightAccessibilityOdhinReportFile}",
    "PLAYWRIGHT_REPORT_TITLE=${playwrightAccessibilityOdhinTitle}",
    "PLAYWRIGHT_REPORT_PROJECT=RPX XUI Media Viewer - Accessibility",
    "TEST_TYPE=${params.ENVIRONMENT}",
    "PLAYWRIGHT_BASE_URL=http://localhost:3000/",
    'A11Y_STRICT=false',
    'PLAYWRIGHT_SKIP_INSTALL=true'
  ]) {
    try {
      yarnBuilder.yarn('test:accessibility:playwright')
    } catch (Exception testException) {
      if (testException instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
        throw testException
      }
      if (testException instanceof hudson.AbortException && ((testException.getMessage() ?: '') =~ /(exit code|status)\s+(129|137|143)/).find()) {
        throw testException
      }
      echo "[playwright-accessibility] Accessibility failed but is non-blocking: ${testException.getClass().getName()}: ${testException.getMessage()}"
    } finally {
      try {
        publishPlaywrightReport(outputRoot, reportName, playwrightAccessibilityOdhinReportFile, false, true)
      } catch (Exception reportException) {
        if (reportException instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
          throw reportException
        }
        echo "[playwright-accessibility] Report publication failed but is non-blocking: ${reportException.getClass().getName()}: ${reportException.getMessage()}"
      }
    }
  }
}

def runPlaywrightCrossbrowserTests = { String outputRoot, String reportName ->
  steps.sh("rm -rf -- '${outputRoot}'")
  withEnv(playwrightBrowsersEnv() + [
    "PLAYWRIGHT_TEST_OUTPUT_DIR=${outputRoot}/test-results",
    "PLAYWRIGHT_JUNIT_OUTPUT=${outputRoot}/playwright-crossbrowser-junit.xml",
    "PLAYWRIGHT_REPORT_FOLDER=${outputRoot}/odhin-report",
    "PLAYWRIGHT_REPORT_INDEX_FILENAME=${playwrightCrossbrowserOdhinReportFile}",
    "PLAYWRIGHT_REPORT_TITLE=${playwrightCrossbrowserOdhinTitle}",
    "TEST_TYPE=${params.ENVIRONMENT}",
    "PLAYWRIGHT_BASE_URL=http://localhost:3000/",
    'PLAYWRIGHT_SKIP_INSTALL=true'
  ]) {
    try {
      yarnBuilder.yarn('test:playwright:crossbrowser')
    } finally {
      publishPlaywrightReport(outputRoot, reportName, playwrightCrossbrowserOdhinReportFile)
    }
  }
}

def vaultOverrides = [
  'aat' : params.ENVIRONMENT,
]

def secrets = [
  "rpx-${params.ENVIRONMENT}": [
    secret('microservicekey-em-gw', 'S2S_KEY'),
    secret('show-oauth2-token', 'IDAM_SECRET'),
    secret('password', 'IDAM_PASSWORD'),
    secret('ccd-user-email', 'CCD_CASEWORKER_E2E_EMAIL'),
    secret('ccd-user-password', 'CCD_CASEWORKER_E2E_PASSWORD'),
    secret('microservicekey-ccd-gw', 'MICROSERVICE_CCD_GW'),
    secret('idam-client-secret', 'IDAM_CLIENT_SECRET')
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [ $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar
  ]
}

timeout(time: 60, unit: 'MINUTES') {
withNightlyPipeline(type, product, component) {
  env.TEST_URL = 'http://localhost:3000'
  env.IDAM_URL = params.IDAM_API_URL
  env.S2S_PROVIDER = params.S2S_PROVIDER_URL
  env.S2S_URL = params.S2S_PROVIDER_URL
  env.CCD_DATA_STORE_API_URL = params.CCD_DATA_STORE_URL
  env.DOCASSEMBLY_URL = "http://dg-docassembly-${params.ENVIRONMENT}.service.core-compute-${params.ENVIRONMENT}.internal"
  env.DM_STORE_APP_URL = "http://dm-store-${params.ENVIRONMENT}.service.core-compute-${params.ENVIRONMENT}.internal"
  env.HRS_API_URL = "http://em-hrs-api-${params.ENVIRONMENT}.service.core-compute-${params.ENVIRONMENT}.internal"
  env.ANNOTATION_API_URL = "http://em-anno-${params.ENVIRONMENT}.service.core-compute-${params.ENVIRONMENT}.internal"
  env.NPA_URL = "http://em-npa-${params.ENVIRONMENT}.service.core-compute-${params.ENVIRONMENT}.internal"
  env.ICP_API_URL = "https://em-icp.${params.ENVIRONMENT}.platform.hmcts.net"
  env.REDIRECT_URL = "https://xui-media-viewer-${params.ENVIRONMENT}.service.core-compute-${params.ENVIRONMENT}.internal/oauth2/callback"
  env.REFORM_ENVIRONMENT = params.ENVIRONMENT
  env.NODE_ENV = "TEST"
  env.RUNNING_ENV = params.ENVIRONMENT
  env.E2E_FAIL_FAST_PREFLIGHT = "true"
  overrideVaultEnvironments(vaultOverrides)
  loadVaultSecrets(secrets)

  disableLegacyDeployment()
  enableSlackNotifications(channel)

  afterSuccess('checkout') {
    env.PUPPETEER_CACHE_DIR = "${env.WORKSPACE}/.cache/puppeteer"
    env.PLAYWRIGHT_BROWSERS_PATH = "${env.WORKSPACE}/.cache/ms-playwright"
    env.PUPPETEER_SKIP_DOWNLOAD = 'true'
    stage('Media Viewer API Setup') {
      withEnv(playwrightBrowsersEnv()) {
        yarnBuilder.yarn('setup:api')
      }
    }
    stage('Puppeteer Chrome Install') {
      yarnBuilder.yarn('puppeteer:install')
      env.PUPPETEER_INSTALL_ALREADY_VERIFIED = 'true'
    }
    stage('Playwright Install Browsers') {
      withEnv(playwrightBrowsersEnv()) {
        yarnBuilder.yarn('test:setup:playwright-install-browsers')
        env.PLAYWRIGHT_SKIP_INSTALL = 'true'
      }
    }
  }

  afterSuccess('build') {
    yarnBuilder.yarn('build')
    yarnBuilder.yarn('copy:demo-files')
    stage('Start local AAT media viewer') {
      sh '''
        set +x
        export IDAM_PASSWORD="${IDAM_PASSWORD:-${CCD_CASEWORKER_E2E_PASSWORD:-}}"
        export NODE_CONFIG="$(node -e "const secrets = { 'show-oauth2-token': process.env.IDAM_SECRET, 'microservicekey-em-gw': process.env.S2S_KEY, password: process.env.IDAM_PASSWORD }; console.log(JSON.stringify({ secrets: { rpx: secrets, 'em-showcase': secrets } }))")"

        rm -f local-aat-api.log local-aat-ng.log
        JENKINS_NODE_COOKIE=dontKillMe nohup yarn start:api > local-aat-api.log 2>&1 &
        api_pid=$!
        for attempt in $(seq 1 60); do
          if ! kill -0 "$api_pid" 2>/dev/null; then
            echo "Local AAT API exited before becoming ready" >&2
            tail -200 local-aat-api.log >&2 || true
            exit 1
          fi

          if curl -fsS http://localhost:1337/health 2>/dev/null | grep -q '"status":"UP"'; then
            echo "Local AAT API is ready"
            break
          fi

          if grep -q "Could not start" local-aat-api.log; then
            echo "Local AAT API startup failed" >&2
            tail -200 local-aat-api.log >&2 || true
            exit 1
          fi

          sleep 2
        done

        if ! curl -fsS http://localhost:1337/health 2>/dev/null | grep -q '"status":"UP"'; then
          echo "Local AAT API did not become ready" >&2
          tail -200 local-aat-api.log >&2 || true
          exit 1
        fi

        node scripts/create-local-aat-test-documents.js \
          --pdf-count 1 \
          --image-count 1 \
          --output .local-aat-documents.env >/dev/null

        JENKINS_NODE_COOKIE=dontKillMe nohup yarn start:ng --host 0.0.0.0 > local-aat-ng.log 2>&1 &
        ng_pid=$!

        for attempt in $(seq 1 90); do
          if ! kill -0 "$ng_pid" 2>/dev/null; then
            echo "Local AAT Angular host exited before becoming ready" >&2
            tail -200 local-aat-ng.log >&2 || true
            exit 1
          fi

          if curl -fsS http://localhost:3000/ >/dev/null 2>&1; then
            echo "Local AAT media viewer is ready"
            exit 0
          fi

          sleep 2
        done

        echo "Local AAT media viewer did not become ready" >&2
        tail -200 local-aat-api.log >&2 || true
        tail -200 local-aat-ng.log >&2 || true
        exit 1
      '''
    }
    stage('Playwright Smoke Test') {
      steps.sh("rm -rf -- '${playwrightSmokeOutputRoot}'")
      withEnv(playwrightBrowsersEnv() + [
        "PLAYWRIGHT_TEST_OUTPUT_DIR=${playwrightSmokeOutputRoot}/test-results",
        "PLAYWRIGHT_JUNIT_OUTPUT=${playwrightSmokeOutputRoot}/playwright-smoke-junit.xml",
        "PLAYWRIGHT_REPORT_FOLDER=${playwrightSmokeOutputRoot}/odhin-report",
        "PLAYWRIGHT_REPORT_INDEX_FILENAME=${playwrightSmokeOdhinReportFile}",
        "PLAYWRIGHT_REPORT_TITLE=${playwrightSmokeOdhinTitle}",
        "TEST_TYPE=${params.ENVIRONMENT}",
        "PLAYWRIGHT_BASE_URL=http://localhost:3000/",
        "PLAYWRIGHT_SKIP_INSTALL=true"
      ]) {
        try {
          yarnBuilder.yarn('test:playwright:smoke')
        } finally {
          publishPlaywrightReport(playwrightSmokeOutputRoot, 'Nightly Playwright Smoke Test', playwrightSmokeOdhinReportFile)
        }
      }
    }
    stage('Playwright Viewer Support Test') {
      steps.sh("rm -rf -- '${playwrightSupportOutputRoot}'")
      withEnv(playwrightBrowsersEnv() + [
        "PLAYWRIGHT_TEST_OUTPUT_DIR=${playwrightSupportOutputRoot}/test-results",
        "PLAYWRIGHT_JUNIT_OUTPUT=${playwrightSupportOutputRoot}/playwright-support-junit.xml",
        "PLAYWRIGHT_REPORT_FOLDER=${playwrightSupportOutputRoot}/odhin-report",
        "PLAYWRIGHT_REPORT_INDEX_FILENAME=${playwrightSupportOdhinReportFile}",
        "PLAYWRIGHT_REPORT_TITLE=${playwrightSupportOdhinTitle}",
        "TEST_TYPE=${params.ENVIRONMENT}",
        "PLAYWRIGHT_BASE_URL=http://localhost:3000/",
        "PLAYWRIGHT_SKIP_INSTALL=true"
      ]) {
        try {
          yarnBuilder.yarn('test:playwright:support')
        } finally {
          publishPlaywrightReport(playwrightSupportOutputRoot, 'Nightly Playwright Viewer Support Test', playwrightSupportOdhinReportFile)
        }
      }
    }
    stage('Playwright Viewer Functional Test') {
      runPlaywrightFunctionalTests(playwrightFunctionalOutputRoot, 'Nightly Playwright Viewer Functional Test')
    }
    if (params.RUN_PLAYWRIGHT_ACCESSIBILITY) {
      stage('Playwright Accessibility Test') {
        runPlaywrightAccessibilityTests(playwrightAccessibilityOutputRoot, 'Nightly Playwright Accessibility Test')
      }
    } else {
      echo '[playwright-accessibility] Nightly accessibility stage omitted; set RUN_PLAYWRIGHT_ACCESSIBILITY=true to run it.'
    }
    stage('Playwright Cross-browser Smoke Test') {
      runPlaywrightCrossbrowserTests(playwrightCrossbrowserOutputRoot, 'Nightly Playwright Cross-browser Smoke Test')
    }
  }

}
}
