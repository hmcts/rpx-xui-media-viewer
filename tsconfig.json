{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "@hmcts/media-viewer": [
        "dist/media-viewer"
      ],
      "@hmcts/media-viewer/*": [
        "dist/media-viewer/*"
      ],
      "core-js/es7/reflect": [
        "node_modules/core-js/proposals/reflect-metadata"
      ],
      "core-js/es6/*": [
        "node_modules/core-js/es"
      ]
    },
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "strict": false,
    "ignoreDeprecations": "6.0",
    "noUncheckedSideEffectImports": false
  }
}
